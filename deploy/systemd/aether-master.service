[Unit]
Description=Aether Master Node
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=aether
Group=aether
WorkingDirectory=/opt/aether
ExecStart=/opt/aether/bin/aether --mode master --port 50051 --web-port 8080 --enable-web true
Restart=on-failure
RestartSec=3
Nice=-5
CPUWeight=900
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
